# Copy to .env and fill in. .env is gitignored.

# Run the pipeline on the fixtures (1) or the real stages (0, needs the real agents).
USE_MOCKS=1

# Read data/universe.json and data/ethics/ instead of fixtures: real screen and ethics check.
REAL_DATA=1

# Make the fixture pipeline react to the client's answers (only matters when REAL_DATA is off).
DEMO_RULES=0

# Azure OpenAI portal key, needed for the chat with Ethos.
AZURE_OPENAI_API_KEY=

# Company logos from logo.dev. This is the publishable key (starts with pk_), safe in the browser. Optional:
# without it the app shows coloured initials. Restart the dev server after changing it.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
# Optional suffix added to every ticker for logo.dev, for example .L
NEXT_PUBLIC_LOGO_DEV_TICKER_SUFFIX=
